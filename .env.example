# Backend environment variables
# Copy to .env and fill in before deploying

# LemonSqueezy API key (from Lemon Squeezy → Settings → API)
LEMONSQUEEZY_API_KEY=your_ls_api_key_here

# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: https://your-vercel-app.vercel.app or your custom domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# Optional: set to "production" to disable reload
ENV=development
